<odoo>

    <record id="res_groups_privilege_omnichannel" model="res.groups.privilege">
        <field name="name">Omnichannel</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_omnichannel_user" model="res.groups">
        <field name="name">Omnichannel User</field>
        <field name="comment">Can read channel logs and leads created from channels.</field>
        <field name="privilege_id" ref="res_groups_privilege_omnichannel"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_omnichannel_manager" model="res.groups">
        <field name="name">Omnichannel Manager</field>
        <field name="comment">Can configure Zalo OA, Facebook and website connectors.</field>
        <field name="privilege_id" ref="res_groups_privilege_omnichannel"/>
        <field name="implied_ids" eval="[(4, ref('group_omnichannel_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
