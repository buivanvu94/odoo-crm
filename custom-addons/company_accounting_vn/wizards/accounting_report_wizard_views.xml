<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accounting_report_wizard_form" model="ir.ui.view">
        <field name="name">accounting.report.wizard.form</field>
        <field name="model">accounting.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sổ kế toán">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <div colspan="2">
                            <button name="action_period_month" type="object" string="Tháng" class="btn-secondary"/>
                            <button name="action_period_quarter" type="object" string="Quý" class="btn-secondary"/>
                            <button name="action_period_year" type="object" string="Năm" class="btn-secondary"/>
                        </div>
                    </group>
                    <group>
                        <field name="account_ids" widget="many2many_tags"
                               invisible="report_type in ('cash', 'bank', 'partner_131', 'partner_331')"
                               domain="[('company_ids', 'in', company_id)]"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="journal_ids" widget="many2many_tags"
                               domain="[('company_id', '=', company_id)]"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_screen" type="object" string="Xem" class="btn-primary" data-hotkey="q"/>
                    <button name="action_print_pdf" type="object" string="In PDF" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Xuất Excel" class="btn-secondary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_accounting_report_wizard" model="ir.actions.act_window">
        <field name="name">Sổ kế toán</field>
        <field name="res_model">accounting.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_accounting_report_wizard" name="Sổ kế toán (TT 99)"
              parent="account.menu_finance_reports" action="action_accounting_report_wizard"
              groups="account.group_account_user" sequence="5"/>

    <!-- Kết quả xem trên màn hình: sổ dạng dòng và bảng cân đối số phát sinh. -->
    <record id="view_accounting_report_line_list" model="ir.ui.view">
        <field name="name">accounting.report.line.list</field>
        <field name="model">accounting.report.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-bf="kind != 'line'" decoration-info="kind == 'group'">
                <field name="kind" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="voucher"/>
                <field name="label"/>
                <field name="account"/>
                <field name="counterpart"/>
                <field name="partner"/>
                <field name="journal"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="bal_debit"/>
                <field name="bal_credit"/>
            </list>
        </field>
    </record>

    <record id="view_accounting_report_line_trial" model="ir.ui.view">
        <field name="name">accounting.report.line.trial</field>
        <field name="model">accounting.report.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-bf="kind != 'line'" decoration-info="kind == 'group'">
                <field name="kind" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="account"/>
                <field name="label"/>
                <field name="open_debit"/>
                <field name="open_credit"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="close_debit"/>
                <field name="close_credit"/>
            </list>
        </field>
    </record>
</odoo>
