<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 khổ dọc cho phiếu thu/chi/nhập/xuất; chứng từ tự dựng đầu trang nên không dùng header của layout. -->
    <record id="paperformat_vn_voucher_a4" model="report.paperformat">
        <field name="name">VN Voucher A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">20</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Sổ sách khổ ngang (dùng chung cho các báo cáo sổ). -->
    <record id="paperformat_vn_ledger_a4_landscape" model="report.paperformat">
        <field name="name">VN Ledger A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
