<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_voucher_vn" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.voucher.vn</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group name="voucher_vn" string="Cash Voucher">
                    <field name="receiver_payer_name"/>
                    <field name="receiver_payer_address"/>
                    <field name="attached_documents"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
