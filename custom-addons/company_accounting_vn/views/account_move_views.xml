<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_einvoice_decree_254" model="ir.ui.view">
        <field name="name">account.move.form.inherit.einvoice.decree.254</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="company_einvoice.view_move_form_einvoice"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_einvoice']" position="after">
                <button name="action_einvoice_dry_run"
                        string="E-Invoice Dry Run"
                        type="object"
                        groups="company_einvoice.group_einvoice_user"
                        invisible="move_type != 'out_invoice' or state != 'posted' or einvoice_state == 'issued'"/>
            </xpath>
            <field name="einvoice_serial" position="after">
                <field name="einvoice_date"/>
                <field name="einvoice_tax_authority_code"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_counterpart" model="ir.ui.view">
        <field name="name">account.move.line.list.counterpart</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="counterpart_name" optional="show" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
