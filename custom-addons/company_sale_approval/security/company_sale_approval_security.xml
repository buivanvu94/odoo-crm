<odoo>

    <record id="group_sale_price_manager" model="res.groups">
        <field name="name">Price Approval Manager</field>
        <field name="sequence">40</field>
        <field name="comment">Can approve quotations whose discount exceeds the company limit or that sell below cost.</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
