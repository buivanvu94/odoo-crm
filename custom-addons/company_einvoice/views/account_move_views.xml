<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_einvoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.einvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_prepare_einvoice"
                        string="Prepare E-Invoice"
                        type="object"
                        invisible="move_type != 'out_invoice' or state != 'posted' or einvoice_state == 'issued'"/>
                <button name="action_send_einvoice"
                        string="Send E-Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or einvoice_state == 'issued'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="E-Invoice" name="einvoice" groups="company_einvoice.group_einvoice_user">
                    <group>
                        <group>
                            <field name="einvoice_provider_id" options="{'no_create': True}"/>
                            <field name="einvoice_state"/>
                            <field name="einvoice_number"/>
                            <field name="einvoice_serial"/>
                        </group>
                        <group>
                            <field name="einvoice_issued_at"/>
                            <field name="einvoice_error" invisible="not einvoice_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="einvoice_payload">
                            <field name="einvoice_payload" readonly="1"/>
                        </page>
                        <page string="Response" name="einvoice_response">
                            <field name="einvoice_response" readonly="1"/>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
