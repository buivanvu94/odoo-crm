<odoo>

    <record id="group_einvoice_user" model="res.groups">
        <field name="name">E-Invoice User</field>
        <field name="comment">Can send customer invoices to the e-invoice provider.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_einvoice_manager" model="res.groups">
        <field name="name">E-Invoice Manager</field>
        <field name="comment">Can configure e-invoice providers.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_einvoice_user')), (4, ref('account.group_account_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
