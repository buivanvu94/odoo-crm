<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_shipment_log_list" model="ir.ui.view">
        <field name="name">company.shipment.log.list</field>
        <field name="model">company.shipment.log</field>
        <field name="arch" type="xml">
            <list string="Lịch sử vận đơn" create="0" edit="0">
                <field name="create_date" string="Thời gian"/>
                <field name="picking_id"/>
                <field name="carrier_id"/>
                <field name="state"/>
                <field name="tracking_ref"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_company_shipment_log_form" model="ir.ui.view">
        <field name="name">company.shipment.log.form</field>
        <field name="model">company.shipment.log</field>
        <field name="arch" type="xml">
            <form string="Lịch sử vận đơn" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="picking_id"/>
                            <field name="carrier_id"/>
                            <field name="tracking_ref"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="message"/>
                            <field name="create_date" string="Thời gian"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_shipment_log" model="ir.actions.act_window">
        <field name="name">Lịch sử vận đơn</field>
        <field name="res_model">company.shipment.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_company_shipment_log"
              name="Lịch sử vận đơn"
              parent="stock.menu_stock_config_settings"
              action="action_company_shipment_log"
              sequence="90"
              groups="stock.group_stock_user"/>

</odoo>
