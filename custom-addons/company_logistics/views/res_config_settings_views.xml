<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_logistics" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.logistics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Internal Transfer Approval" name="internal_transfer_approval">
                    <setting string="Require approval for internal transfers"
                             help="Block validation of internal transfers above the amount limit until a logistics manager approves.">
                        <field name="internal_transfer_approval"/>
                        <div class="mt-2" invisible="not internal_transfer_approval">
                            <label for="internal_transfer_limit" class="me-2"/>
                            <field name="internal_transfer_limit" class="oe_inline" widget="monetary"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
