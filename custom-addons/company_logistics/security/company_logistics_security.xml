<odoo>

    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Logistics Manager</field>
        <field name="comment">Can approve internal transfers above the limit and manage carriers.</field>
        <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
