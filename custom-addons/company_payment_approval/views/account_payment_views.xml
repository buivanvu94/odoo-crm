<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_payment_approval" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.payment.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_payment_approval"
                        string="Request Payment Approval"
                        type="object"
                        class="btn-primary"
                        invisible="not needs_payment_approval or payment_approval_state in ('to_approve', 'approved') or state != 'draft'"/>
                <button name="action_approve_payment"
                        string="Approve Payment"
                        type="object"
                        class="btn-primary"
                        groups="company_payment_approval.group_payment_approval_manager"
                        invisible="payment_approval_state != 'to_approve' or state != 'draft'"/>
                <button name="action_refuse_payment"
                        string="Refuse Payment"
                        type="object"
                        groups="company_payment_approval.group_payment_approval_manager"
                        invisible="payment_approval_state != 'to_approve' or state != 'draft'"/>
                <button name="action_reset_payment_approval"
                        string="Reset Approval"
                        type="object"
                        groups="company_payment_approval.group_payment_approval_manager"
                        invisible="payment_approval_state == 'not_required' or state != 'draft'"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <group name="payment_approval" string="Payment Approval"
                       invisible="not needs_payment_approval and payment_approval_state == 'not_required'">
                    <field name="needs_payment_approval" invisible="1"/>
                    <field name="payment_approval_state" readonly="1"/>
                    <field name="payment_approver_id" invisible="not payment_approver_id"/>
                    <field name="payment_approval_date" invisible="not payment_approval_date"/>
                    <field name="payment_approval_note" placeholder="Lý do / ghi chú duyệt thanh toán..."/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_payment_approval" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.payment.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">payment_approval_state == 'to_approve'</attribute>
                <attribute name="decoration-success">payment_approval_state == 'approved'</attribute>
                <attribute name="decoration-danger">payment_approval_state == 'refused'</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="payment_approval_state" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
