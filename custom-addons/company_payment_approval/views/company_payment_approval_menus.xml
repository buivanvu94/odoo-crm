<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_company_payment_approval" model="ir.actions.act_window">
        <field name="name">Duyệt thanh toán</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'outbound'), ('payment_approval_state', '=', 'to_approve')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Không có phiếu thanh toán nào đang chờ duyệt
            </p>
        </field>
    </record>

    <menuitem id="menu_company_payment_approval"
              name="Duyệt thanh toán"
              parent="account.menu_finance_payables"
              action="action_company_payment_approval"
              sequence="21"
              groups="company_payment_approval.group_payment_approval_manager"/>

</odoo>
