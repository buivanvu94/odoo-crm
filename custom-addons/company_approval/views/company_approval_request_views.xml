<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="company_approval_request_view_list" model="ir.ui.view">
        <field name="name">company.approval.request.list</field>
        <field name="model">company.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-muted="state == 'draft'" decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="request_type"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="date_request"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'refused'"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="company_approval_request_view_form" model="ir.ui.view">
        <field name="name">company.approval.request.form</field>
        <field name="model">company.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" groups="company_approval.group_approval_manager" invisible="state != 'submitted'"/>
                    <button name="action_refuse" string="Refuse" type="object" groups="company_approval.group_approval_manager" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type"/>
                            <field name="requested_by"/>
                            <field name="date_request"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approver_id"/>
                            <field name="date_approval"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason" placeholder="Describe what you need and why..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="company_approval_request_view_search" model="ir.ui.view">
        <field name="name">company.approval.request.search</field>
        <field name="model">company.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="approver_id"/>
                <filter name="my_requests" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Waiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_refused" string="Refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'request_type'}"/>
                <filter name="group_requested_by" string="Requested By" context="{'group_by': 'requested_by'}"/>
            </search>
        </field>
    </record>

</odoo>
