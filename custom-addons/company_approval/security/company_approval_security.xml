<odoo>

    <record id="res_groups_privilege_company_approval" model="res.groups.privilege">
        <field name="name">Approvals</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can create and follow their own approval requests.</field>
        <field name="privilege_id" ref="res_groups_privilege_company_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approver</field>
        <field name="comment">Can approve or refuse every request of the company.</field>
        <field name="privilege_id" ref="res_groups_privilege_company_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
